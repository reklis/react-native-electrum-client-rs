namespace electrum_client_rs {
    [Throws=ElectrumError]
    ElectrumResponse start(StartConfig config);

    [Throws=ElectrumError]
    ElectrumResponse stop(string network);

    [Throws=ElectrumError]
    ElectrumResponse ping_server(string network);

    [Throws=ElectrumError]
    ElectrumResponse get_header(string network, u32 height);

    [Throws=ElectrumError]
    ElectrumResponse get_balance(string network, sequence<string> script_hashes);
};

dictionary StartConfig {
    string network;
    sequence<Peer>? custom_peers;
};

dictionary Peer {
    string host;
    u16? ssl;
    u16? tcp;
    string? protocol;
};

dictionary ElectrumResponse {
    boolean error;
    string? data;
    string? method;
};

[Error]
enum ElectrumError {
    "ConnectionFailed",
    "InvalidNetwork",
    "InvalidResponse",
    "Timeout",
    "AlreadyConnected",
    "NotConnected",
    "Other",
};
